# Server configuration
SERVER_PORT=8080
GRPC_PORT=50051

# PostgreSQL database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hypercatalog
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_POOL_SIZE=5
