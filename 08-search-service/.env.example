# ── Search Service environment variables ─────────────────────────────────────
# Copy this file to .env and fill in real values

# ── gRPC server ──────────────────────────────────────────────────────────────
GRPC_PORT=50058

# ── HTTP server ──────────────────────────────────────────────────────────────
HTTP_PORT=8083

# ── Elasticsearch ────────────────────────────────────────────────────────────
ES_HOSTS=http://elasticsearch:9200
ES_INDEX_NAME=products
# ES_USER=elastic
# ES_PASSWORD=changeme
# ES_CLOUD_ID=
# ES_API_KEY=

# ── Database (PostgreSQL — for audit / persistence layer) ────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_SIZE=2
DB_MAX_SIZE=10

# ── Catalog service (gRPC) ───────────────────────────────────────────────────
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=50051

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
