# HyperScale Marketplace — Admin Service Environment Variables

# === Database (PostgreSQL) ===
DB_HOST=db-admin.hyper.local
DB_PORT=5432
DB_NAME=hyper_admin
DB_USER=admin
DB_PASSWORD=changeme_admin_db
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# === Redis ===
REDIS_HOST=redis.hyper.local
REDIS_PORT=6379
REDIS_DB=10
REDIS_PASSWORD=changeme_redis

# === gRPC — Auth Service ===
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50052

# === gRPC — Catalog Service ===
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=50051

# === gRPC — Order Service ===
ORDER_SERVICE_HOST=order-service
ORDER_SERVICE_PORT=50055

# === gRPC — Seller Service ===
SELLER_SERVICE_HOST=seller-service
SELLER_SERVICE_PORT=9090

# === Admin Service Ports ===
GRPC_PORT=50053
HTTP_PORT=8085

# === Logging ===
LOG_LEVEL=info
