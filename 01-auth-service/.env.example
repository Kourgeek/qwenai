# ---- Auth Service (Phase 2) ----
GRPC_PORT=50052

# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Application ----
APP_NAME=hyperauth-service
APP_ENV=development
LOG_LEVEL=INFO
