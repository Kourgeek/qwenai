# ============================================================
# HyperScale Marketplace — Environment Variables Template
# ============================================================
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# ⚠️ SECURITY NOTES:
#   - NEVER commit .env to version control
#   - Use secrets management in production (Vault, AWS Secrets Manager, etc.)
#   - Rotate JWT secrets regularly
#   - Use strong passwords for all databases
#   - Never use placeholder values in production
# ============================================================

# ============================================================
# GENERAL SETTINGS
# ============================================================

# Application environment (development, staging, production)
APP_ENV=development

# Debug mode (1 = enabled, 0 = disabled)
DEBUG=1

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=debug

# Log format (text, json)
LOG_FORMAT=text

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================

# PostgreSQL connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace

# Per-service database names (each service uses its own database)
DB_AUTH_NAME=auth_db
DB_USER_SERVICE_NAME=user_db
DB_CATALOG_NAME=catalog_db
DB_CART_NAME=cart_db
DB_ORDER_NAME=order_db
DB_PAYMENT_NAME=payment_db
DB_NOTIFICATION_NAME=notification_db
DB_SEARCH_NAME=search_db
DB_SELLER_NAME=seller_db
DB_ADMIN_NAME=admin_db

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# SSL mode (disable, allow, prefer, require, verify-full)
DB_SSL_MODE=disable

# ============================================================
# REDIS
# ============================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Per-service Redis DB assignments
REDIS_AUTH_DB=0
REDIS_CATALOG_DB=1
REDIS_CART_DB=3
REDIS_NOTIFICATION_DB=4
REDIS_BFF_DB=5

# Cache TTL settings (in seconds)
REDIS_CART_TTL=86400
REDIS_SESSION_TTL=3600
REDIS_TOKEN_TTL=3600

# ============================================================
# ELASTICSEARCH
# ============================================================

ES_HOSTS=http://elasticsearch:9200
ES_INDEX_NAME=products
ES_USERNAME=
ES_PASSWORD=
ES_SNIFF=false
ES_HEALTHCHECK_ENABLED=true
ES_HEALTHCHECK_INTERVAL=30s
ES_MAX_RETRIES=3
ES_TIMEOUT=30

# ============================================================
# KAFKA
# ============================================================

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=marketplace-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=1000

# Topic names
KAFKA_ORDER_CREATED_TOPIC=order.created
KAFKA_ORDER_STATUS_CHANGED_TOPIC=order.status_changed
KAFKA_PAYMENT_COMPLETED_TOPIC=payment.completed
KAFKA_PAYMENT_FAILED_TOPIC=payment.failed
KAFKA_TOPIC=marketplace-events

# ============================================================
# AUTH SERVICE
# ============================================================

# JWT Configuration
JWT_SECRET=change-me-to-a-strong-random-string-in-production
JWT_EXPIRY=3600
JWT_ISSUER=auth-service
JWT_ALGORITHM=HS256

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================
# GATEWAY / BFF SERVICE
# ============================================================

# CORS settings
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# Rate limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# BFF specific
BFF_REDIS_PREFIX=bff:
BFF_TOKEN_TTL=3600

# ============================================================
# PAYMENT SERVICE
# ============================================================

# Stripe configuration
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# YooMoney (ЮKassa) configuration
YOOMONEY_SHOP_ID=
YOOMONEY_TOKEN=

# Payment settings
PAYMENT_CURRENCY=RUB
PAYMENT_TIMEOUT=1800

# ============================================================
# NOTIFICATION SERVICE
# ============================================================

# SMTP Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@marketplace.local
SMTP_ENABLE_TLS=false
SMTP_USE_SSL=false

# Push notifications
PUSH_PROVIDER=firebase
PUSH_ENABLED=false
PUSH_API_KEY=
PUSH_PROJECT_ID=

# SMS notifications
SMS_PROVIDER=twilio
SMS_ENABLED=false
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ============================================================
# SELLER SERVICE
# ============================================================

# Seller-specific settings
SELLER_API_KEY=
SELLER_API_SECRET=
SELLER_BASE_URL=

# ============================================================
# MONITORING
# ============================================================

# Prometheus
PROMETHEUS_ENDPOINT=http://prometheus:9090
PROMETHEUS_PUSH_INTERVAL=15

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# MAILHOG (Development SMTP)
# ============================================================

MAILHOG_HOST=mailhog
MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

# ============================================================
# PRODUCTION SECRETS (use secrets manager in production)
# ============================================================

# ⚠️ These must be set via secrets manager in production:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# DOCKER_USERNAME=
# DOCKER_PASSWORD=
# VAULT_TOKEN=
# VAULT_ADDR=https://vault.example.com:8200

# ============================================================
# DOMAIN / URL CONFIGURATION
# ============================================================

# API Gateway URL
GATEWAY_URL=http://localhost:8080

# Service discovery URLs (for local development)
AUTH_SERVICE_URL=http://auth-service:50052
USER_SERVICE_URL=http://user-service:50053
CATALOG_SERVICE_URL=http://catalog-service:8080
CART_SERVICE_URL=http://cart-service:8081
ORDER_SERVICE_URL=http://order-service:8085
PAYMENT_SERVICE_URL=http://payment-service:8082
NOTIFICATION_SERVICE_URL=http://notification-service:8086
SEARCH_SERVICE_URL=http://search-service:8083
SELLER_SERVICE_URL=http://seller-service:8085
ADMIN_SERVICE_URL=http://admin-service:8085
BFF_SERVICE_URL=http://bff-service:8085

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable/disable specific features
ENABLE_KAFKA_INTEGRATION=true
ENABLE_REDIS_CACHE=true
ENABLE_PROMETHEUS_METRICS=true
ENABLE_RATE_LIMITING=false
ENABLE_CORS=true
ENABLE_SWAGGER=true
