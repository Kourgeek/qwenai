# ──────────────────────────────────────────────────────────────
# User Service — Environment Variables
# Copy to .env and override as needed.
# ──────────────────────────────────────────────────────────────

# gRPC / HTTP port
GRPC_PORT=50053

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=user_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# ── Auth Service (gRPC) ──────────────────────────────────────
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50052

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
