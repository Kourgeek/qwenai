# gRPC server port
GRPC_PORT=50050

# HTTP server port
SERVER_PORT=8081

# Database configuration (optional — cart uses Redis primarily)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cart_service
DB_USER=cart_service
DB_PASSWORD=change_me
DB_MIN_SIZE=5
DB_MAX_SIZE=20

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_CART_TTL=86400
REDIS_SAVED_TTL=2592000

# Auth service gRPC
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50052

# Catalog service gRPC
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=50051

# Logging
LOG_LEVEL=INFO
