# gRPC server port
GRPC_PORT=9090

# HTTP server port
HTTP_PORT=8085

# PostgreSQL database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hypermarket_seller
DB_USER=seller_service
DB_PASSWORD=seller_service_secret
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=9
REDIS_PASSWORD=

# Auth service (gRPC)
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50052

# Catalog service (gRPC)
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=50051

# Order service (gRPC)
ORDER_SERVICE_HOST=order-service
ORDER_SERVICE_PORT=50055

# Logging
LOG_LEVEL=INFO
