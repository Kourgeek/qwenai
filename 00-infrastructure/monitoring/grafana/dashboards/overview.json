{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Container CPU Usage",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container!=\"\", pod=~\"$pod\"}[5m]) * 100",
          "legendFormat": "{{pod}} - {{container}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "percent", "label": "CPU %" },
        { "format": "short" }
      ],
      "xaxis": { "mode": "time" },
      "legend": { "show": true, "placement": "bottom" }
    },
    {
      "id": 2,
      "title": "Container Memory Usage",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container!=\"\", pod=~\"$pod\"} / 1024 / 1024",
          "legendFormat": "{{pod}} - {{container}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "bytes", "label": "Memory (MB)" },
        { "format": "short" }
      ],
      "xaxis": { "mode": "time" },
      "legend": { "show": true, "placement": "bottom" }
    },
    {
      "id": 3,
      "title": "Container Disk I/O",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{container!=\"\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}} - reads",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{container!=\"\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}} - writes",
          "refId": "B"
        }
      ],
      "yaxes": [
        { "format": "Bps", "label": "Disk I/O" },
        { "format": "short" }
      ],
      "xaxis": { "mode": "time" },
      "legend": { "show": true, "placement": "bottom" }
    },
    {
      "id": 4,
      "title": "Network Traffic",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{container!=\"\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}} - rx",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{container!=\"\", pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}} - tx",
          "refId": "B"
        }
      ],
      "yaxes": [
        { "format": "Bps", "label": "Network (B/s)" },
        { "format": "short" }
      ],
      "xaxis": { "mode": "time" },
      "legend": { "show": true, "placement": "bottom" }
    },
    {
      "id": 5,
      "title": "Container Health Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "kube_pod_status_phase{phase=\"Running\"} > 0",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "mappings": [
        { "options": { "0": { "color": "red", "text": "Down" }, "1": { "color": "green", "text": "Running" } }, "type": "value" }
      ],
      "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 0.5 },
        { "color": "green", "value": 1 }
      ]},
      "colorMode": "background",
      "graphMode": "area"
    },
    {
      "id": 6,
      "title": "Container Restart Count",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{pod=~\"$pod\"}[1h])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "short", "label": "Restarts" },
        { "format": "short" }
      ],
      "xaxis": { "mode": "time" },
      "legend": { "show": true, "placement": "bottom" }
    },
    {
      "id": 7,
      "title": "Container Uptime (hours)",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "time() - kube_pod_container_status_started_at{pod=~\"$pod\"} > 0",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "columns": [
        { "text": "Time", "value": "Time" },
        { "text": "Pod", "value": "pod" },
        { "text": "Uptime (h)", "value": "Value" }
      ],
      "styles": [
        { "pattern": "Uptime (h)", "type": "number", "unit": "hours" }
      ]
    },
    {
      "id": 8,
      "title": "Service Health Summary",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (service) (up{job=~\"$service\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "mappings": [
        { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
      ],
      "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 0.5 },
        { "color": "green", "value": 1 }
      ]},
      "colorMode": "background",
      "graphMode": "area"
    },
    {
      "id": 9,
      "title": "Node Resource Overview",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(node_cpu_seconds_total{mode!=\"idle\"}) by (instance) / count(node_cpu_seconds_total{mode=\"idle\"}) by (instance) * 100",
          "legendFormat": "{{instance}} CPU",
          "refId": "A"
        },
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}} Memory",
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 60 },
          { "color": "red", "value": 80 }
        ]
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hyperscale", "overview", "system"],
  "templating": {
    "list": [
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "label": "Pod"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "label": "Service"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "title": "HyperScale Marketplace - System Overview",
  "uid": "hyperscale-overview",
  "version": 1
}
