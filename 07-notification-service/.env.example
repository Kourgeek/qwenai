# gRPC port
GRPC_PORT=50057

# HTTP port (FastAPI)
HTTP_PORT=8086

# Kafka configuration
KAFKA_BROKERS=kafka:9092
KAFKA_ORDER_TOPIC=order.created
KAFKA_PAYMENT_TOPIC=payment.completed
KAFKA_REFUND_TOPIC=payment.refunded

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Email (SMTP) configuration
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=noreply@marketplace.local
MAIL_PASSWORD=

# Logging
LOG_LEVEL=info
